generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Tarea {
  id         Int      @id @default(autoincrement())
  titulo     String
  prioridad  String   @default("media")
  completada Boolean  @default(false)
  creadaEn   DateTime @default(now())
}
